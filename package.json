{
	"name": "rcpassos.me",
	"version": "0.2.0",
	"scripts": {
		"dev": "vite dev --host",
		"build": "vite build",
		"deploy-gh-pages": "touch build/.nojekyll && echo 'rcpassos.me' > ./build/CNAME && gh-pages -d build -t true",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"lint-fix": "prettier --write . && eslint .",
		"format": "prettier --write .",
		"update": "npx npm-check-updates -u",
		"prepare": "svelte-kit sync"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^26.6.6",
		"@vcarl/remark-headings": "^0.1.0",
		"cssnano": "^9.9.0",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"gh-pages": "^6.3.0",
		"globals": "^17.13.0",
		"mdsvex": "^0.12.8",
		"mdsvex-relative-images": "^2.0.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"rehype-autolink-headings": "^7.1.0",
		"rehype-slug": "^6.0.0",
		"remark-reading-time": "^2.1.0",
		"sass": "^1.107.0",
		"shiki": "^4.5.0",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.7",
		"svelte-preprocess": "^6.0.5",
		"typescript": "^6.0.3",
		"unist-util-visit": "^5.2.0",
		"vite": "^8.3.5"
	},
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@dagrejs/dagre": "^3.1.3",
		"@picocss/pico": "^2.1.1",
		"@xyflow/svelte": "^1.7.0",
		"clsx": "^2.1.1",
		"date-fns": "^4.4.0",
		"katex": "^0.19.1",
		"marked": "^18.1.2",
		"node-html-parser": "^9.0.5",
		"reading-time": "^1.5.0",
		"reading-time-estimator": "^2.15.0",
		"rehype-katex": "^7.0.1",
		"rehype-stringify": "^10.0.1",
		"remark-math": "^6.0.0",
		"remark-parse": "^11.0.0",
		"remark-rehype": "^11.1.2"
	}
}
