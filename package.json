{
	"name": "rcpassos.me",
	"version": "0.2.0",
	"scripts": {
		"dev": "vite dev --host",
		"predev": "node scripts/generate-og-images.mjs",
		"build": "vite build",
		"prebuild": "node scripts/generate-og-images.mjs",
		"generate:og": "node scripts/generate-og-images.mjs",
		"deploy-gh-pages": "touch build/.nojekyll && echo 'rcpassos.me' > ./build/CNAME && gh-pages -d build -t true",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"lint-fix": "prettier --write . && eslint .",
		"format": "prettier --write .",
		"update": "npx npm-check-updates",
		"prepare": "svelte-kit sync"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@mdsvex/plugin-anchors": "^0.1.1",
		"@mdsvex/plugin-external-links": "^0.1.1",
		"@mdsvex/plugin-toc": "^0.1.2",
		"@resvg/resvg-js": "^2.6.2",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.4.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.2",
		"@types/node": "^26.6.11",
		"cssnano": "^9.9.0",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.9",
		"eslint-plugin-svelte": "^3.24.1",
		"gh-pages": "^6.3.0",
		"globals": "^17.14.0",
		"mdsvex": "^1.1.0",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.2.0",
		"sass": "^1.108.2",
		"satori": "^0.63.2",
		"satori-html": "^0.3.2",
		"shiki": "^4.6.0",
		"svelte": "^5.59.2",
		"svelte-check": "^4.7.8",
		"svelte-preprocess": "^6.0.5",
		"typescript": "^6.0.3",
		"vite": "^8.4.0"
	},
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@dagrejs/dagre": "^3.1.4",
		"@picocss/pico": "^2.1.1",
		"@xyflow/svelte": "^2.0.3",
		"clsx": "^2.1.1",
		"date-fns": "^4.4.0",
		"katex": "^0.19.1",
		"marked": "^18.3.0",
		"node-html-parser": "^9.0.7",
		"reading-time": "^1.5.0"
	}
}
